# =====================================================
# Variables d'environnement — Chatbot RNCP Dev IA
# =====================================================
# Copier ce fichier en .env et remplir les valeurs réelles.
# .env est dans .gitignore — il ne doit JAMAIS être commité.

# --- Mistral API ---
# Récupère ta clé sur https://console.mistral.ai/api-keys
MISTRAL_API_KEY=ta-cle-mistral-ici

# Modèles Mistral utilisés (laisser les valeurs par défaut sauf si tu sais ce que tu fais)
MISTRAL_LLM_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed

# --- Qdrant ---
# En local via docker-compose, l'URL est http://qdrant:6333 (réseau Docker interne)
# En dev sans Docker, c'est http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=referentiel_rncp

# --- Paramètres RAG ---
# Tunables pour la soutenance — chaque valeur doit être justifiable
CHUNK_SIZE=512                # Taille des chunks en caractères (sweet spot 2026)
CHUNK_OVERLAP=80              # Chevauchement pour préserver le contexte aux frontières (~15%)
RETRIEVAL_K=4                 # Nombre de chunks retournés par le retriever
SCORE_THRESHOLD=0.4           # Seuil minimum de similarité (anti-hallucination)

# --- Optionnel : Langfuse pour l'observabilité (Phase 3) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxxx
# LANGFUSE_HOST=http://localhost:3000
